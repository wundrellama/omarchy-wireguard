[Unit]
Description=Omarchy WireGuard early fail-closed firewall
DefaultDependencies=no
Before=network-pre.target NetworkManager.service
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -m omarchy_wireguard.daemon --fail-closed
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/lib/omarchy-wireguard/backend
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sysinit.target
