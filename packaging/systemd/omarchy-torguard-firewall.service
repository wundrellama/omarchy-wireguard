[Unit]
Description=Omarchy TorGuard early fail-closed firewall
DefaultDependencies=no
Before=network-pre.target NetworkManager.service
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -m omarchy_torguard.daemon --fail-closed
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/lib/omarchy-torguard/backend
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sysinit.target
