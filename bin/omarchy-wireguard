#!/usr/bin/python3
import argparse
import json
import os
import re
import socket
import stat
import subprocess
import sys
import tempfile
import uuid
import zipfile
from pathlib import Path


SOCKET_PATH = "/run/omarchy-wireguard/control.sock"
MAX_RESPONSE = 512 * 1024
PROFILE_PREFIX = "omarchy-wireguard-"


class CliError(RuntimeError):
    pass


def call(operation, arguments=None):
    request = {
        "op": operation,
        "args": arguments or {},
        "request_id": str(uuid.uuid4()),
    }
    payload = json.dumps(request, separators=(",", ":")).encode() + b"\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(30)
            client.connect(SOCKET_PATH)
            client.sendall(payload)
            client.shutdown(socket.SHUT_WR)
            chunks = []
            size = 0
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                size += len(chunk)
                if size > MAX_RESPONSE:
                    raise CliError("backend response is too large")
                chunks.append(chunk)
    except (FileNotFoundError, ConnectionRefusedError):
        raise CliError("WireGuard backend is not installed or running") from None
    except (OSError, TimeoutError) as exc:
        raise CliError("could not contact WireGuard backend") from exc
    try:
        response = json.loads(b"".join(chunks))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CliError("backend returned an invalid response") from exc
    if not response.get("ok"):
        error = response.get("error") or {}
        raise CliError(str(error.get("message") or "backend request failed"))
    return response


def stage_files(paths):
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, staged = tempfile.mkstemp(prefix="omarchy-wireguard-", suffix=".zip", dir=runtime)
    os.fchmod(fd, 0o600)
    os.close(fd)
    try:
        with zipfile.ZipFile(staged, "w", compression=zipfile.ZIP_DEFLATED) as archive:
            seen = set()
            for value in paths:
                path = Path(value)
                info = path.lstat()
                if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                    raise CliError("multiple imports must be regular configuration files")
                if info.st_uid != os.getuid() or not path.name.lower().endswith(".conf"):
                    raise CliError("configuration files must be owned by the current user and end in .conf")
                name = path.name
                if name in seen:
                    raise CliError("duplicate source filename; rename the input files explicitly")
                seen.add(name)
                archive.write(path, name)
        return staged
    except Exception:
        Path(staged).unlink(missing_ok=True)
        raise


def import_profiles(paths, locations, label=None, labels=None):
    if label is not None and (len(paths) != 1 or not paths[0].lower().endswith(".conf")):
        raise CliError("--label requires one .conf file; use --labels for a batch")
    metadata = {}
    for option, value in (("locations", locations), ("labels", labels)):
        if value is not None:
            try:
                parsed = json.loads(value)
            except json.JSONDecodeError as exc:
                raise CliError(f"--{option} must be a JSON object") from exc
            if not isinstance(parsed, dict):
                raise CliError(f"--{option} must be a JSON object")
            metadata[option] = parsed
    staged = None
    try:
        path = paths[0]
        if len(paths) > 1:
            staged = stage_files(paths)
            path = staged
        arguments = {"path": str(Path(path).expanduser().absolute())}
        if label is not None:
            arguments["labels"] = {Path(path).name: label}
        arguments.update(metadata)
        return call("import", arguments)
    finally:
        if staged:
            Path(staged).unlink(missing_ok=True)


def emergency_disable():
    if os.geteuid() != 0:
        raise CliError("emergency-disable must be run with sudo")
    state_dir = Path("/var/lib/omarchy-wireguard")
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    dns_state_path = state_dir / "dns.json"
    dns_restore = []
    dns_state_error = False
    try:
        value = json.loads(dns_state_path.read_text(encoding="utf-8"))
        if not isinstance(value, list) or len(value) > 16:
            raise ValueError
        for item in value:
            if (not isinstance(item, list) or len(item) != 3 or
                    not isinstance(item[0], str) or
                    not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", item[0]) or
                    not isinstance(item[1], list) or len(item[1]) > 32 or
                    not all(isinstance(domain, str) and 0 < len(domain) <= 255 and
                            "\n" not in domain and "\r" not in domain for domain in item[1]) or
                    not isinstance(item[2], bool)):
                raise ValueError
            dns_restore.append((item[0], tuple(item[1]), item[2]))
    except FileNotFoundError:
        pass
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        dns_state_error = True
    # Keep the early-firewall unit active: NetworkManager requires it, so stopping it
    # would also stop NetworkManager.
    subprocess.run(["systemctl", "disable", "--now", "omarchy-wireguard.service"], check=True)
    active = subprocess.run(
        ["nmcli", "-t", "-f", "NAME,UUID", "connection", "show", "--active"],
        text=True, capture_output=True, check=False,
    )
    for line in active.stdout.splitlines():
        name, separator, connection_uuid = line.rpartition(":")
        if separator and name.startswith(PROFILE_PREFIX):
            subprocess.run(["nmcli", "connection", "down", "uuid", connection_uuid], check=True)
    dns_restore_failed = dns_state_error
    links = subprocess.run(["ip", "-json", "link", "show"], text=True,
                           capture_output=True, check=False)
    try:
        link_values = json.loads(links.stdout) if links.returncode == 0 else []
        if not isinstance(link_values, list):
            raise ValueError
        existing = {item.get("ifname") for item in link_values if isinstance(item, dict)}
        if dns_restore and links.returncode != 0:
            dns_restore_failed = True
    except (json.JSONDecodeError, ValueError):
        existing = set()
        dns_restore_failed = True
    for interface, domains, default_route in dns_restore:
        if interface not in existing:
            continue
        commands = [
            ["resolvectl", "domain", interface, *(domains or ("",))],
            ["resolvectl", "default-route", interface, "yes" if default_route else "no"],
        ]
        for command in commands:
            if subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode != 0:
                dns_restore_failed = True
    if subprocess.run(["systemctl", "is-active", "--quiet", "omarchy-wireguard.service"],
                      check=False).returncode == 0:
        raise CliError("could not stop omarchy-wireguard.service")
    remaining = subprocess.run(
        ["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"],
        text=True, capture_output=True, check=True,
    )
    if any(line.startswith(PROFILE_PREFIX) for line in remaining.stdout.splitlines()):
        raise CliError("a managed WireGuard connection is still active")
    if dns_restore_failed:
        raise CliError("physical DNS settings could not be restored; traffic remains blocked")
    fd, temporary = tempfile.mkstemp(prefix=".state.json.", dir=state_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            fd = -1
            stream.write('{"enabled":false,"mru":[],"target":null}\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, state_dir / "state.json")
    finally:
        if fd >= 0:
            os.close(fd)
        Path(temporary).unlink(missing_ok=True)
    dns_state_path.unlink(missing_ok=True)
    subprocess.run(["nft", "delete", "table", "inet", "omarchy_wireguard"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if subprocess.run(["nft", "list", "table", "inet", "omarchy_wireguard"], check=False,
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise CliError("the WireGuard firewall table is still active")
    return {"ok": True, "result": {"mode": "disabled", "emergency": True}}


def parser():
    root = argparse.ArgumentParser(prog="omarchy-wireguard")
    commands = root.add_subparsers(dest="command", required=True)
    for name in ("status", "list", "disconnect", "retry", "diagnostics", "emergency-disable"):
        commands.add_parser(name)
    connect = commands.add_parser("connect")
    target = connect.add_mutually_exclusive_group(required=True)
    target.add_argument("city", nargs="?", help="legacy country/city location")
    target.add_argument("--profile", help="exact stable profile ID from list")
    pause = commands.add_parser("pause")
    pause.add_argument("seconds", nargs="?", type=int, default=600)
    import_command = commands.add_parser("import")
    import_command.add_argument("paths", nargs="+")
    import_command.add_argument("--locations")
    labels = import_command.add_mutually_exclusive_group()
    labels.add_argument("--label", help="display name for one personal .conf file")
    labels.add_argument("--labels", help="JSON object mapping source filenames to display names")
    return root


def main():
    arguments = parser().parse_args()
    try:
        if arguments.command in ("status", "list", "disconnect", "retry", "diagnostics"):
            response = call(arguments.command)
        elif arguments.command == "connect":
            target = {"profile": arguments.profile} if arguments.profile is not None else {"city": arguments.city}
            response = call("connect", target)
        elif arguments.command == "pause":
            response = call("pause", {"seconds": arguments.seconds})
        elif arguments.command == "import":
            response = import_profiles(arguments.paths, arguments.locations, arguments.label, arguments.labels)
        else:
            response = emergency_disable()
        print(json.dumps(response, separators=(",", ":"), sort_keys=True))
    except (CliError, OSError, subprocess.SubprocessError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
