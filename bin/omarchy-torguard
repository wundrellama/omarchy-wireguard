#!/usr/bin/python3
import argparse
import json
import os
import re
import socket
import stat
import subprocess
import sys
import tempfile
import uuid
import zipfile
from pathlib import Path


SOCKET_PATH = "/run/omarchy-torguard/control.sock"
MAX_RESPONSE = 512 * 1024
PROFILE_PREFIX = "omarchy-torguard-"


class CliError(RuntimeError):
    pass


def call(operation, arguments=None):
    request = {
        "op": operation,
        "args": arguments or {},
        "request_id": str(uuid.uuid4()),
    }
    payload = json.dumps(request, separators=(",", ":")).encode() + b"\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(30)
            client.connect(SOCKET_PATH)
            client.sendall(payload)
            client.shutdown(socket.SHUT_WR)
            chunks = []
            size = 0
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                size += len(chunk)
                if size > MAX_RESPONSE:
                    raise CliError("backend response is too large")
                chunks.append(chunk)
    except (FileNotFoundError, ConnectionRefusedError):
        raise CliError("TorGuard backend is not installed or running") from None
    except (OSError, TimeoutError) as exc:
        raise CliError("could not contact TorGuard backend") from exc
    try:
        response = json.loads(b"".join(chunks))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CliError("backend returned an invalid response") from exc
    if not response.get("ok"):
        error = response.get("error") or {}
        raise CliError(str(error.get("message") or "backend request failed"))
    return response


def alfred_policy():
    try:
        result = subprocess.run(
            ["nmcli", "-f", "connection.interface-name,wireguard.peers", "connection", "show", "alfred-vpn"],
            check=True, text=True, capture_output=True, timeout=5,
            env={"PATH": "/usr/bin:/usr/sbin", "LANG": "C"},
        )
    except (OSError, subprocess.SubprocessError):
        return None
    interface = ""
    peers = ""
    for line in result.stdout.splitlines():
        key, separator, value = line.partition(":")
        if not separator:
            continue
        if key.strip() == "connection.interface-name":
            interface = value.strip()
        elif key.strip() == "wireguard.peers":
            peers += " " + value.strip()
    if interface != "alfred-vpn":
        return None
    endpoint_match = re.search(r"endpoint=(\[[0-9a-fA-F:]+\]|[0-9.]+):(\d+)", peers)
    routes_match = re.search(r"allowed-ips=([^ ]+)", peers)
    if not endpoint_match or not routes_match:
        return None
    endpoint = endpoint_match.group(1).strip("[]")
    routes = [item for item in routes_match.group(1).split(",") if item]
    return {
        "interface": "alfred-vpn",
        "endpoints": [[endpoint, int(endpoint_match.group(2))]],
        "routes": routes,
    }


def stage_files(paths):
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, staged = tempfile.mkstemp(prefix="omarchy-torguard-", suffix=".zip", dir=runtime)
    os.fchmod(fd, 0o600)
    os.close(fd)
    try:
        with zipfile.ZipFile(staged, "w", compression=zipfile.ZIP_DEFLATED) as archive:
            seen = set()
            for index, value in enumerate(paths):
                path = Path(value)
                info = path.lstat()
                if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                    raise CliError("multiple imports must be regular configuration files")
                if info.st_uid != os.getuid() or not path.name.lower().endswith(".conf"):
                    raise CliError("configuration files must be owned by the current user and end in .conf")
                name = path.name
                if name in seen:
                    name = f"{index + 1}-{name}"
                seen.add(name)
                archive.write(path, name)
        return staged
    except Exception:
        Path(staged).unlink(missing_ok=True)
        raise


def import_profiles(paths, locations):
    staged = None
    try:
        path = paths[0]
        if len(paths) > 1:
            staged = stage_files(paths)
            path = staged
        arguments = {"path": str(Path(path).expanduser().resolve())}
        if locations:
            try:
                arguments["locations"] = json.loads(locations)
            except json.JSONDecodeError as exc:
                raise CliError("--locations must be a JSON object") from exc
        network = {"lan_resolvers": []}
        alfred = alfred_policy()
        if alfred:
            network["alfred"] = alfred
        arguments["network"] = network
        return call("import", arguments)
    finally:
        if staged:
            Path(staged).unlink(missing_ok=True)


def emergency_disable():
    if os.geteuid() != 0:
        raise CliError("emergency-disable must be run with sudo")
    state_dir = Path("/var/lib/omarchy-torguard")
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".state.json.", dir=state_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            fd = -1
            stream.write('{"enabled":false,"mru":[],"target":null}\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, state_dir / "state.json")
    finally:
        if fd >= 0:
            os.close(fd)
        Path(temporary).unlink(missing_ok=True)
    # Keep the early-firewall unit active: NetworkManager requires it, so stopping it
    # would also stop NetworkManager. The persisted disabled state makes its next run
    # remove rather than install policy.
    subprocess.run(["systemctl", "disable", "--now", "omarchy-torguard.service"], check=True)
    active = subprocess.run(
        ["nmcli", "-t", "-f", "NAME,UUID", "connection", "show", "--active"],
        text=True, capture_output=True, check=False,
    )
    for line in active.stdout.splitlines():
        name, separator, connection_uuid = line.rpartition(":")
        if separator and name.startswith(PROFILE_PREFIX):
            subprocess.run(["nmcli", "connection", "down", "uuid", connection_uuid], check=True)
    subprocess.run(["nft", "delete", "table", "inet", "omarchy_torguard"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if subprocess.run(["systemctl", "is-active", "--quiet", "omarchy-torguard.service"],
                      check=False).returncode == 0:
        raise CliError("could not stop omarchy-torguard.service")
    remaining = subprocess.run(
        ["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"],
        text=True, capture_output=True, check=True,
    )
    if any(line.startswith(PROFILE_PREFIX) for line in remaining.stdout.splitlines()):
        raise CliError("a managed TorGuard connection is still active")
    if subprocess.run(["nft", "list", "table", "inet", "omarchy_torguard"], check=False,
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise CliError("the TorGuard firewall table is still active")
    return {"ok": True, "result": {"mode": "disabled", "emergency": True}}


def parser():
    root = argparse.ArgumentParser(prog="omarchy-torguard")
    commands = root.add_subparsers(dest="command", required=True)
    for name in ("status", "list", "disconnect", "retry", "diagnostics", "emergency-disable"):
        commands.add_parser(name)
    connect = commands.add_parser("connect")
    connect.add_argument("city")
    pause = commands.add_parser("pause")
    pause.add_argument("seconds", nargs="?", type=int, default=600)
    import_command = commands.add_parser("import")
    import_command.add_argument("paths", nargs="+")
    import_command.add_argument("--locations")
    return root


def main():
    arguments = parser().parse_args()
    try:
        if arguments.command in ("status", "list", "disconnect", "retry", "diagnostics"):
            response = call(arguments.command)
        elif arguments.command == "connect":
            response = call("connect", {"city": arguments.city})
        elif arguments.command == "pause":
            response = call("pause", {"seconds": arguments.seconds})
        elif arguments.command == "import":
            response = import_profiles(arguments.paths, arguments.locations)
        else:
            response = emergency_disable()
        print(json.dumps(response, separators=(",", ":"), sort_keys=True))
    except (CliError, OSError, subprocess.SubprocessError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
