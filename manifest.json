{
  "schemaVersion": 1,
  "id": "wundrellama.wireguard",
  "name": "WireGuard",
  "version": "1.1.0",
  "author": "wundrellama",
  "license": "MIT",
  "description": "Named WireGuard profiles, connection status and traffic statistics for Omarchy.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "plugin/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "WireGuard",
    "description": "Show WireGuard state and traffic, connect to named profiles, retry, and import profiles.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "closedRefreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "closedRefreshIntervalSec",
        "type": "integer",
        "label": "Closed refresh interval (seconds)",
        "min": 15,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
