#!/bin/bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run with sudo" >&2; exit 1; }
controller_user="${1:-}"
[[ $controller_user =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo "Controller user required" >&2; exit 1; }

/usr/bin/omarchy-wireguard emergency-disable
/usr/bin/omarchy-wireguard uninstall-profiles

controller_uid=$(id -u "$controller_user")
home=$(getent passwd "$controller_user" | cut -d: -f6)
runuser -u "$controller_user" -- env HOME="$home" USER="$controller_user" \
  XDG_RUNTIME_DIR="/run/user/$controller_uid" OMARCHY_PATH=/usr/share/omarchy \
  /usr/lib/omarchy-wireguard/integrate-user remove

rm -f /etc/systemd/system/NetworkManager.service.d/50-omarchy-wireguard.conf
systemctl daemon-reload
systemctl disable --now omarchy-wireguard-firewall.service
rm -rf /var/lib/omarchy-wireguard /etc/omarchy-wireguard /usr/lib/omarchy-wireguard
rm -f /usr/bin/omarchy-wireguard /usr/lib/systemd/system/omarchy-wireguard.service \
  /usr/lib/systemd/system/omarchy-wireguard-firewall.service
systemctl daemon-reload
echo "WireGuard backend removed; remove the Omarchy plugin separately with: omarchy plugin remove wundrellama.wireguard"
