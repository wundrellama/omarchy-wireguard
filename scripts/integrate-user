#!/bin/bash
set -euo pipefail

mode="${1:-install}"

# The installer runs this outside the desktop session with the packaged
# OMARCHY_PATH. The session can run Omarchy from another checkout, and the
# shell answers only callers that use the same path, so prefer the session's.
session_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n1) || true
if [[ -n $session_path && -f $session_path/shell/shell.qml ]]; then
  export OMARCHY_PATH=$session_path
fi
if [[ -n ${OMARCHY_PATH:-} && -d $OMARCHY_PATH/bin ]]; then
  export PATH="$OMARCHY_PATH/bin:$PATH"
fi

extension="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
mkdir -p "$(dirname "$extension")"
[[ -f $extension ]] || printf '{\n}\n' >"$extension"

python3 - "$mode" "$extension" <<'PY'
import re
import sys
from pathlib import Path

mode, filename = sys.argv[1:]
path = Path(filename)
text = path.read_text(encoding="utf-8")
start = "  // omarchy-wireguard:start"
end = "  // omarchy-wireguard:end"
entry = ('  "setup.network.wireguard": {"icon":"󰦝","label":"WireGuard VPN",'
         '"aliases":["torguard","vpn","wireguard"],'
         '"action":"omarchy-shell shell toggle wundrellama.wireguard {}"}')

pattern = re.compile(r"\n?\s*// omarchy-wireguard:start\n.*?\n\s*// omarchy-wireguard:end\n?", re.S)
text = pattern.sub("\n", text)

def significant_before_close(source):
    close = source.rfind("}")
    if close < 0:
        raise SystemExit("menu extension is not a JSONC object")
    prefix = re.sub(r"//[^\n]*|/\*.*?\*/", "", source[:close], flags=re.S).rstrip()
    return close, prefix[-1:] if prefix else ""

close, previous = significant_before_close(text)
if mode == "install":
    comma = "" if previous in ("{", ",") else ","
    block = f"{comma}\n{start}\n{entry}\n{end}\n"
    text = text[:close].rstrip() + block + text[close:]
else:
    text = re.sub(r",\s*\n(\s*})", r"\n\1", text)

temporary = path.with_name(path.name + ".omarchy-wireguard.tmp")
temporary.write_text(text, encoding="utf-8")
temporary.replace(path)
PY

if [[ $mode == install ]]; then
  # The bar placement is cosmetic; the plugin works without it.
  if ! omarchy bar move wundrellama.wireguard --section right --before omarchy.network >/dev/null; then
    echo "omarchy-wireguard: warning: could not place the bar widget;" \
      "run: omarchy bar move wundrellama.wireguard --section right --before omarchy.network" >&2
  fi
  omarchy menu refresh >/dev/null 2>&1 || true
fi
