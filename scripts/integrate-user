#!/bin/bash
set -euo pipefail

mode="${1:-install}"
extension="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
mkdir -p "$(dirname "$extension")"
[[ -f $extension ]] || printf '{\n}\n' >"$extension"

python3 - "$mode" "$extension" <<'PY'
import re
import sys
from pathlib import Path

mode, filename = sys.argv[1:]
path = Path(filename)
text = path.read_text(encoding="utf-8")
start = "  // omarchy-wireguard:start"
end = "  // omarchy-wireguard:end"
entry = ('  "setup.network.wireguard": {"icon":"󰦝","label":"WireGuard VPN",'
         '"aliases":["torguard","vpn","wireguard"],'
         '"action":"omarchy-shell shell toggle nicolasdorier.wireguard {}"}')

pattern = re.compile(r"\n?\s*// omarchy-wireguard:start\n.*?\n\s*// omarchy-wireguard:end\n?", re.S)
text = pattern.sub("\n", text)

def significant_before_close(source):
    close = source.rfind("}")
    if close < 0:
        raise SystemExit("menu extension is not a JSONC object")
    prefix = re.sub(r"//[^\n]*|/\*.*?\*/", "", source[:close], flags=re.S).rstrip()
    return close, prefix[-1:] if prefix else ""

close, previous = significant_before_close(text)
if mode == "install":
    comma = "" if previous in ("{", ",") else ","
    block = f"{comma}\n{start}\n{entry}\n{end}\n"
    text = text[:close].rstrip() + block + text[close:]
else:
    text = re.sub(r",\s*\n(\s*})", r"\n\1", text)

temporary = path.with_name(path.name + ".omarchy-wireguard.tmp")
temporary.write_text(text, encoding="utf-8")
temporary.replace(path)
PY

if [[ $mode == install ]]; then
  omarchy bar move nicolasdorier.wireguard --section right --before omarchy.network >/dev/null
  omarchy menu refresh >/dev/null 2>&1 || true
fi
