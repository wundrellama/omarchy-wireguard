#!/bin/bash
set -euo pipefail

fail() {
  echo "omarchy-wireguard: $*" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || fail "backend installation must run as root"
controller_user="${1:-}"
[[ $controller_user =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "a valid controller user is required"
controller_uid=$(id -u "$controller_user" 2>/dev/null) || fail "controller user does not exist"
[[ $controller_uid -ge 1000 ]] || fail "controller must be an unprivileged login user"

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_dir=$(cd -- "$script_dir/.." && pwd -P)
[[ -f $repo_dir/manifest.json && -d $repo_dir/backend/omarchy_wireguard ]] || fail "invalid plugin checkout"
if find "$repo_dir/backend" "$repo_dir/bin" "$repo_dir/packaging" -type l -print -quit | grep -q .; then
  fail "installation source must not contain symlinks"
fi

if ! command -v wg >/dev/null 2>&1; then
  pacman -S --needed --noconfirm wireguard-tools
fi

install -d -m 0755 /usr/lib/omarchy-wireguard /etc/omarchy-wireguard \
  /etc/systemd/system/NetworkManager.service.d
stage=$(mktemp -d /usr/lib/omarchy-wireguard/.backend.XXXXXX)
backup=""
backup_cli=""
backup_integrate=""
backup_uninstall=""
backup_service=""
backup_firewall_service=""
backup_config=""
backup_networkmanager_dropin=""
transaction_started=false
backend_replaced=false
daemon_was_enabled=$(systemctl is-enabled omarchy-wireguard.service 2>/dev/null || true)
daemon_was_active=$(systemctl is-active omarchy-wireguard.service 2>/dev/null || true)
firewall_was_enabled=$(systemctl is-enabled omarchy-wireguard-firewall.service 2>/dev/null || true)
firewall_was_active=$(systemctl is-active omarchy-wireguard-firewall.service 2>/dev/null || true)
cleanup() {
  trap - ERR
  trap '' HUP INT TERM
  set +e
  [[ -z $stage ]] || rm -rf "$stage"
  [[ $transaction_started == true ]] || return 0
  transaction_started=false
  if [[ $backend_replaced == true ]]; then
    rm -rf /usr/lib/omarchy-wireguard/backend
    if [[ -n $backup && -d $backup ]]; then
      mv "$backup" /usr/lib/omarchy-wireguard/backend
    fi
  fi
  rm -f /usr/bin/omarchy-wireguard /usr/lib/omarchy-wireguard/integrate-user \
    /usr/lib/omarchy-wireguard/uninstall-backend \
    /usr/lib/systemd/system/omarchy-wireguard.service \
    /usr/lib/systemd/system/omarchy-wireguard-firewall.service \
    /etc/omarchy-wireguard/backend.conf \
    /etc/systemd/system/NetworkManager.service.d/50-omarchy-wireguard.conf
  [[ -z $backup_cli ]] || mv "$backup_cli" /usr/bin/omarchy-wireguard
  [[ -z $backup_integrate ]] || mv "$backup_integrate" /usr/lib/omarchy-wireguard/integrate-user
  [[ -z $backup_uninstall ]] || mv "$backup_uninstall" /usr/lib/omarchy-wireguard/uninstall-backend
  [[ -z $backup_service ]] || mv "$backup_service" /usr/lib/systemd/system/omarchy-wireguard.service
  [[ -z $backup_firewall_service ]] || mv "$backup_firewall_service" /usr/lib/systemd/system/omarchy-wireguard-firewall.service
  [[ -z $backup_config ]] || mv "$backup_config" /etc/omarchy-wireguard/backend.conf
  [[ -z $backup_networkmanager_dropin ]] || mv "$backup_networkmanager_dropin" /etc/systemd/system/NetworkManager.service.d/50-omarchy-wireguard.conf
  # Load the restored units and dependency graph before changing service state.
  # This prevents stopping NetworkManager through a stale cached Requires edge.
  if ! systemctl daemon-reload >/dev/null 2>&1; then
    echo "Rollback incomplete: could not reload restored systemd units; services retained to avoid stopping NetworkManager" >&2
    return 0
  fi
  if [[ $daemon_was_enabled == enabled ]]; then
    systemctl enable omarchy-wireguard.service >/dev/null 2>&1 || true
  else
    systemctl disable omarchy-wireguard.service >/dev/null 2>&1 || true
  fi
  if [[ $firewall_was_enabled == enabled ]]; then
    systemctl enable omarchy-wireguard-firewall.service >/dev/null 2>&1 || true
  else
    systemctl disable omarchy-wireguard-firewall.service >/dev/null 2>&1 || true
  fi
  if [[ $daemon_was_active == active ]]; then
    systemctl restart omarchy-wireguard.service >/dev/null 2>&1 || true
  else
    systemctl stop omarchy-wireguard.service >/dev/null 2>&1 || true
  fi
  if [[ $firewall_was_active == active ]]; then
    systemctl start omarchy-wireguard-firewall.service >/dev/null 2>&1 || true
  else
    systemctl stop omarchy-wireguard-firewall.service >/dev/null 2>&1 || true
    nft delete table inet omarchy_wireguard >/dev/null 2>&1 || true
  fi
}
trap cleanup ERR
trap 'cleanup; exit 1' HUP INT TERM
cp -R --no-preserve=ownership "$repo_dir/backend/omarchy_wireguard" "$stage/"
if find "$stage" -type l -print -quit | grep -q .; then
  fail "staged backend contains a symlink"
fi
chown -R root:root "$stage"
find "$stage" -type d -exec chmod 0755 {} +
find "$stage" -type f -exec chmod 0644 {} +
for target_and_variable in \
  "/usr/bin/omarchy-wireguard:backup_cli" \
  "/usr/lib/omarchy-wireguard/integrate-user:backup_integrate" \
  "/usr/lib/omarchy-wireguard/uninstall-backend:backup_uninstall" \
  "/usr/lib/systemd/system/omarchy-wireguard.service:backup_service" \
  "/usr/lib/systemd/system/omarchy-wireguard-firewall.service:backup_firewall_service" \
  "/etc/omarchy-wireguard/backend.conf:backup_config" \
  "/etc/systemd/system/NetworkManager.service.d/50-omarchy-wireguard.conf:backup_networkmanager_dropin"; do
  target=${target_and_variable%%:*}
  variable=${target_and_variable##*:}
  if [[ -e $target ]]; then
    saved="${target}.previous.$$"
    cp -a "$target" "$saved"
    printf -v "$variable" '%s' "$saved"
  fi
done
transaction_started=true
install -m 0755 "$repo_dir/bin/omarchy-wireguard" /usr/bin/omarchy-wireguard
install -m 0755 "$repo_dir/scripts/integrate-user" /usr/lib/omarchy-wireguard/integrate-user
install -m 0755 "$repo_dir/scripts/uninstall-backend" /usr/lib/omarchy-wireguard/uninstall-backend
install -m 0644 "$repo_dir/packaging/systemd/omarchy-wireguard.service" /usr/lib/systemd/system/omarchy-wireguard.service
install -m 0644 "$repo_dir/packaging/systemd/omarchy-wireguard-firewall.service" /usr/lib/systemd/system/omarchy-wireguard-firewall.service

config=$(mktemp)
trap 'rm -f "$config"' EXIT
printf 'CONTROLLER_UID=%s\n' "$controller_uid" >"$config"
install -m 0600 "$config" /etc/omarchy-wireguard/backend.conf

# Publish the backend last. Until this point, an interrupted upgrade leaves the
# old daemon paired with a new CLI that can still use its bounded inline import.
if [[ -d /usr/lib/omarchy-wireguard/backend ]]; then
  backup="/usr/lib/omarchy-wireguard/.backend.previous.$$"
  cp -a /usr/lib/omarchy-wireguard/backend "$backup"
fi
backend_replaced=true
rm -rf /usr/lib/omarchy-wireguard/backend
mv "$stage" /usr/lib/omarchy-wireguard/backend
stage=""

systemctl daemon-reload
systemd-analyze verify omarchy-wireguard-firewall.service omarchy-wireguard.service NetworkManager.service
# Reconcile policy with the new backend without stopping the firewall unit. A
# restart would propagate to NetworkManager once its dependency drop-in exists.
PYTHONPATH=/usr/lib/omarchy-wireguard/backend \
  /usr/bin/python3 -m omarchy_wireguard.daemon --fail-closed
systemctl enable --now omarchy-wireguard-firewall.service
systemctl enable omarchy-wireguard.service
systemctl restart omarchy-wireguard.service
systemctl is-active --quiet omarchy-wireguard-firewall.service omarchy-wireguard.service

install -m 0644 "$repo_dir/packaging/systemd/50-omarchy-wireguard.conf" \
  /etc/systemd/system/NetworkManager.service.d/50-omarchy-wireguard.conf
systemctl daemon-reload

transaction_started=false
trap - ERR
trap - HUP INT TERM
rm -rf "$backup" "$backup_cli" "$backup_integrate" "$backup_uninstall" \
  "$backup_service" "$backup_firewall_service" "$backup_config" \
  "$backup_networkmanager_dropin" || true
backup=""
backup_cli=""
backup_integrate=""
backup_uninstall=""
backup_service=""
backup_firewall_service=""
backup_config=""
backup_networkmanager_dropin=""

home=$(getent passwd "$controller_user" | cut -d: -f6)
runuser -u "$controller_user" -- env HOME="$home" USER="$controller_user" \
  XDG_RUNTIME_DIR="/run/user/$controller_uid" OMARCHY_PATH=/usr/share/omarchy \
  /usr/lib/omarchy-wireguard/integrate-user install

echo "WireGuard backend installed for $controller_user"
